POSTGRES_USER=smartcar
POSTGRES_PASSWORD=smartcar
POSTGRES_DB=smartcar_ops

DATABASE_URL=postgresql+asyncpg://smartcar:smartcar@postgres:5432/smartcar_ops
REDIS_URL=redis://redis:6379/0

GOV_API_RESOURCE_ID=053cea08-09bc-40ec-8f7a-156f0677aff3
REDIS_CACHE_TTL_SECONDS=86400

NEXT_PUBLIC_API_URL=http://localhost:8000

# Workshop key: required (header X-Write-Key) to ADD maintenance / inspection records. Empty = writing is disabled.
# Generate your own, keep it only in .env (git-ignored):   python -c "import secrets; print(secrets.token_urlsafe(18))"
RECORDS_WRITE_KEY=
# Dashboard origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Garage ratings / opening hours from Google (OPTIONAL; the garages section works without it). Put the key ONLY in your local .env and restrict it to "Places API (New)".
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_LIMIT=30

# OpenAI (optional): without a key the chat answers deterministically from the same facts. Put the key ONLY in your local .env, never in chat, git or screenshots.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
